---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getTagSummaries } from '../../lib/tags';

export const getStaticPaths = (async () => {
  const tags = await getTagSummaries();
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { name: tag.name, articles: tag.items },
  }));
}) satisfies GetStaticPaths;

const { name, articles } = Astro.props;
---

<BaseLayout title={`#${name}`} description={`#${name} が付いた記事の一覧`}>
  <h1 class="page-title">#{name}</h1>
  <p class="page-lead">{articles.length} 件の記事があります。</p>
  <ArticleList articles={articles} />
</BaseLayout>
